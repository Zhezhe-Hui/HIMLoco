+            if occ.shape != cost.shape:
+                raise ValueError("occ_bev shape does not match traversability map")
+            cost[occ] = float(np.clip(obstacle_cost, 0.0, 1.0))
+        return np.clip(cost, 0.0, 1.0).astype(np.float32)
