<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- 规范的功能包名称（全小写） -->
  <name>bigdog_urdf</name>
  <version>1.0.0</version>
  <description>URDF Description package for Bigdog robot (ROS2 Humble)</description>
  <maintainer email="your_email@example.com">your_name</maintainer>
  <license>BSD</license>

  <!-- ROS2构建工具（替换ROS1的catkin） -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2核心依赖（替换ROS1的rviz/roslaunch） -->
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>rviz2</depend>  <!-- ROS2的rviz是rviz2，不是rviz -->
  <depend>urdf</depend>
  <depend>xacro</depend>
  <depend>gazebo_ros</depend>  <!-- ROS2的gazebo依赖是gazebo_ros，不是gazebo -->

  <!-- ROS2必需：导出构建类型 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
